// ~/.config/xkb/symbols/local
//
// Custom XKB symbol definitions for Swedish layout.
// See ../../../dotfiles/xkb/README.md for complete mappings.
//
// Format: key <KEYCODE> { [ level1, level2, level3, level4 ] };
// Example: key <AD07> { [ u, U, 7 ] };   // u, Shift+u→U, Super+u→7

partial alphanumeric_keys
xkb_symbols "local" {
    key <TLDE> { [ grave, asciitilde ] };
    key <AE11> { [ minus, underscore ] };
    key <AE12> { [ equal, plus, asterisk ] };
    key <AD07> { [ u, U, 7 ] };
    key <AD08> { [ i, I, 8 ] };
    key <AD09> { [ o, O, 9 ] };
    key <AD11> { [ bracketleft, braceleft, parenleft ] };
    key <AD12> { [ bracketright, braceright, parenright ] };
    key <AC02> { [ s, S, dollar ] };
    key <AC07> { [ j, J, 4 ] };
    key <AC08> { [ k, K, 5 ] };
    key <AC09> { [ l, L, 6 ] };
    key <AC10> { [ semicolon, colon, BackSpace ] };
    key <AC11> { [ apostrophe, quotedbl, bar ] };
    key <AB06> { [ n, N, 0 ] };
    key <AB07> { [ m, M, 1 ] };
    key <AB08> { [ comma, less, 2 ] };
    key <AB09> { [ period, greater, 3 ] };
    key <AB10> { [ slash, question, ampersand, backslash ] };
};

