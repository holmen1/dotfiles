# lf (list files) - minimal terminal file manager: https://github.com/gokcehan/lf
# Docs and config examples: https://github.com/gokcehan/lf/wiki

# interpreter for shell commands
set shell bash
set shellopts '-eu'

# Show hidden files by default
set hidden

# set internal field separator (IFS) to "\n" for shell commands
set ifs "\n"

# leave some space at the top and the bottom of the screen
set scrolloff 10

# Use the `dim` attribute instead of underline for the cursor in the preview pane
set cursorpreviewfmt "\033[7;2m"

# Set previewer
set previewer ~/.config/lf/preview.sh

# ====================
# KEYBINDINGS
# ====================

# Backtick: Clear/refresh the output pane
# Press this after running a command to view output
map ` !true

# execute current file (must be executable)
# Run file in BACKGROUND - lf stays responsive, command runs asynchronously
map x $$f
# Run file in FOREGROUND - lf blocks/waits for command to complete
map X !$f

# Map Enter to open command
map <enter> open

# mkdir command
map a :push %mkdir<space>

# rename command
map r rename

# move to trash
map zd trash

# tar
map ze :extract
map zc :push :compress<space> 

# open terminal
map gt terminal_here

# ====================
# COMMANDS
# ====================

# define a custom 'open' command
cmd open &{{
    case $(file --mime-type -Lb $f) in
	text/html)
	    "$BROWSER" "$f" &
	;;
        text/*|application/json|application/*+json)
	    lf -remote "send $id \$$EDITOR \$fx"
	;;
        image/*)
	    feh --scale-down "$f" &
	;;
        *)
	    xdg-open "$f" &
	;;
    esac
}}

# make sure trash folder exists and move files to trash
%mkdir -p $HOME/.trash
cmd trash %set -f; mv $fx $HOME/.trash

# extract the current file with the right command
# (xkcd link: https://xkcd.com/1168/)
cmd extract ${{
    set -f
    case "$f" in
        *.tar.bz|*.tar.bz2|*.tbz|*.tbz2) tar xjvf "$f";;
        *.tar.gz|*.tgz) tar xzvf "$f";;
        *.tar.xz|*.txz) tar xJvf "$f";;
        *.zip) unzip "$f";;
        *.rar) unrar x "$f";;
        *.7z) 7z x "$f";;
    esac
}}

# compress current file or selected files with tar and gunzip
cmd compress ${{
    set -f
    mkdir "$1"
    cp -r $fx "$1"
    tar czf "$1.tar.gz" "$1"
    rm -rf "$1"
}}

# Open terminal in current working directory (user)
cmd terminal_here ${{
    dir="$PWD"; [ -d "$f" ] && dir="$f"
    setsid -f "$TERMINAL" -e bash -lc 'cd "$1"; exec bash -l' _ "$dir" >/dev/null 2>&1
}}

