# Decrease brightness (Arch: XF86, FreeBSD: F5)
"sudo backlight decr 10"
    XF86MonBrightnessDown

# Increase brightness
"sudo backlight incr 10"
    XF86MonBrightnessUp

# Free BSD
#"backlight decr 10"
#    F5
#"backlight incr 10"
#    F6

# Simple Volume Controls
"amixer sset Master 10%+"
    XF86AudioRaiseVolume

"amixer sset Master 10%-"
    XF86AudioLowerVolume

"amixer sset Master toggle"
    XF86AudioMute
