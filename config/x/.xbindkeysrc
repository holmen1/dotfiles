# Decrease brightness (Arch: XF86, FreeBSD: F5)
"xbacklight -dec 10"
    XF86MonBrightnessDown

"backlight decr 10"
    F5

# Increase brightness
"xbacklight -inc 10"
    XF86MonBrightnessUp

"backlight incr 10"
    F6

# Simple Volume Controls
"wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 10%+"
    XF86AudioRaiseVolume

"wpctl set-volume -l 1.5 @DEFAULT_AUDIO_SINK@ 10%-"
    XF86AudioLowerVolume

"wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"
    XF86AudioMute
