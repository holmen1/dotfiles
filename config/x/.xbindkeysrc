# Decrease brightness
"xbacklight -dec 10"
    XF86MonBrightnessDown

# Increase brightness
"xbacklight -inc 10"
    XF86MonBrightnessUp

# Simple Volume Controls
"amixer sset Master 10%+"
    XF86AudioRaiseVolume

"amixer sset Master 10%-"
    XF86AudioLowerVolume

"amixer sset Master toggle"
    XF86AudioMute
