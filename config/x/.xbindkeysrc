# Decrease brightness (Arch: XF86, FreeBSD: F5)
"xbacklight -dec 10"
    XF86MonBrightnessDown

"backlight decr 10"
    F5

# Increase brightness
"xbacklight -inc 10"
    XF86MonBrightnessUp

"backlight incr 10"
    F6

# Simple Volume Controls
"amixer -c 1 sset Master 10%+"
    XF86AudioRaiseVolume

"amixer -c 1 sset Master 10%-"
    XF86AudioLowerVolume

"amixer -c 1 sset Master toggle"
    XF86AudioMute
